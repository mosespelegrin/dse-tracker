target/
dse-track/target/
*.class

# Frontend build output / deps
frontend/node_modules/
frontend/dist/
frontend/.angular/

# Never commit real secrets — application.properties only holds env-var
# placeholders, but this is a safety net for any local override files.
.env
.env.local
*.env
!*.env.example

# IDE / editor
.idea/
*.iml
*.ipr
*.iws
.vscode/
.settings/
.classpath
.project

# AI tooling / session-local, not project source
.claude/
.agents/

# OS files
.DS_Store
Thumbs.db
desktop.ini
