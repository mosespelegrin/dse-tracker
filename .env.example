# Copy this file to .env and fill in real values before running
# docker-compose in production. Never commit the real .env file — it's
# already in .gitignore.

# A long random string (32+ bytes). Generate one with: openssl rand -base64 48
JWT_SECRET=

# MySQL root password (used by both the mysql and app containers)
DB_PASSWORD=

# Gmail (or other SMTP) credentials for alert/verification/reset emails.
# For Gmail, MAIL_PASSWORD must be an App Password, not your normal password:
# myaccount.google.com/apppasswords
MAIL_USERNAME=
MAIL_PASSWORD=

# Public URL of the frontend — used to build links inside emails
FRONTEND_URL=https://your-domain.example

# Public URL of the backend API — baked into the frontend at container
# startup (see frontend/docker-entrypoint.sh), so the browser knows where to call
API_URL=https://api.your-domain.example

# Comma-separated list of origins allowed to call the API (should match
# FRONTEND_URL, and any other domain the frontend is served from)
CORS_ALLOWED_ORIGINS=https://your-domain.example
